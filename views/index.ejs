<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Posting Site</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <div class="page">
      <header class="header header-bar">
        <!-- Navigation bar with login/logout/account controls. -->
        <div>
          <p class="sitename">Blog Posting Site</p>
        </div>
        <div class="auth-actions">
          <% if (user) { %>
            <span class="welcome-text">Hello, <%= user.name %></span>
            <a href="/logout" class="btn btn-ghost">Logout</a>
          <% } else { %>
            <a href="/signin" class="btn btn-ghost">Sign In</a>
            <a href="/signup" class="btn btn-primary">Sign Up</a>
          <% } %>
        </div>
      </header>

      <main>
        <% if (error) { %>
          <p class="alert error"><%= error %></p>
        <% } %>

        <% if (user) { %>
          <!-- Create a new blog post here. -->
          <section class="compose">
            <h1>New post</h1>
            <form action="/posts" method="POST" class="post-form">
              <div class="form-row">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" required placeholder="My thoughts on" />
              </div>
              <div class="form-row">
                <label for="body">Post</label>
                <textarea id="body" name="body" rows="6" required placeholder="Write your blog post here"></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Publish</button>
            </form>
          </section>
        <% } else { %>
          <!-- prompted to sign in. -->
          <section class="compose guest-banner">
            <h1>Start Posting</h1>
            <p>Please sign in or create an account to write and edit posts.</p>
            <div class="auth-actions centered-actions">
              <a href="/signin" class="btn btn-primary">Sign In</a>
              <a href="/signup" class="btn btn-ghost">Sign Up</a>
            </div>
          </section>
        <% } %>
        <!-- Display all the posts. -->
        <section class="postfeed">
          <h2>
            <%= posts.length === 1 ? "1 post" : posts.length + " posts" %>
          </h2>

          <% if (posts.length === 0) { %>
            <p class="emptyspace">No posts yet.</p>
          <% } else { %>
            <ul class="postlist">
              <% posts.forEach(function (post) { %>
                <li class="post">
                  <article>
                    <header class="post-header">
                      <h3 class="post-title"><%= post.title %></h3>
                      <p class="postmeta">
                        <span class="post-author"><%= post.author %></span>
                        <span aria-hidden="true">·</span>
                        <time><%= new Date(post.createdAt).toLocaleString() %></time>
                      </p>
                    </header>
                    <p class="post-content"><%= post.content %></p>

                    <% if (user && post.creator_user_id === user.user_id) { %>
                      <!-- Only the creator sees edit/delete controls. -->
                      <div class="post-actions">
                        <a href="/posts/<%= post.id %>/edit" class="btn btn-ghost">Edit</a>
                        <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Delete this post?');">
                          <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                      </div>
                    <% } %>
                  </article>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </section>
      </main>
      <footer class="footer">
        <p>CS312 Mini-Project 3</p>
      </footer>
    </div>
  </body>
</html>
