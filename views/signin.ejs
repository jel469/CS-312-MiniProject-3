<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="page auth-page">
      <header class="header auth-header">
        <p class="sitename">Welcome back</p>
      </header>
      <main class="auth-main">
        <section class="auth-card">
          <% if (error) { %>
            <p class="alert error"><%= error %></p>
          <% } %>

          <% if (success) { %>
            <p class="alert success"><%= success %></p>
          <% } %>

          <!-- Authenticates the entered user_id and password. -->
          <form action="/signin" method="POST" class="post-form">
            <div class="form-row">
              <label for="user_id">User ID</label>
              <input type="text" id="user_id" name="user_id" required placeholder="Jane_Doe" />
            </div>

            <div class="form-row">
              <label for="password">Password</label>
              <input type="password" id="password" name="password" required placeholder="Enter your password" />
            </div>

            <button type="submit" class="btn btn-primary">Sign In</button>
          </form>

          <p class="switch-link">
            Need an account?
            <a href="/signup">Create one</a>
          </p>
        </section>
      </main>
    </div>
  </body>
</html>
